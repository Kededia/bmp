# Optional override for persisted settings.
# BMP_SETTINGS_PATH=

# Preferred: let yt-dlp read an authenticated browser/profile.
# YouTube playback requires yt-dlp and Node.js on PATH;
# the live spectrum additionally requires ffmpeg on PATH.
# Optional flat local cache directory, overriding the folder chosen in setup;
# defaults to a music folder beside the settings file. Relative paths are
# resolved from that folder too.
BMP_MUSIC_DIR=
# Optional; overrides the browser chosen in setup.
# Examples: edge, chrome, "chrome:Profile 1", firefox
YTMUSIC_BROWSER=
# Manual fallback: Cookie header content from music.youtube.com.
YTMUSIC_COOKIES=""
# Optional when several Google accounts are signed in; defaults to 0.
YTMUSIC_AUTH_USER=0
# Optional for YouTube channel/brand profiles; copy X-Goog-PageId from the same request.
YTMUSIC_PAGE_ID=
